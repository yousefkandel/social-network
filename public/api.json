                        "maxLength": 2048
                    }
                },
                "required": [
                    "content"
                ],
                "title": "PostRequest"
            },
            "PostResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "content": {
                        "type": "string"
                    },
                    "image_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "author": {
                        "type": "object",
